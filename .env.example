# OpenRouter authentication and role models
OPENROUTER_API_KEY=
OPENROUTER_EXPERT_MODEL=poolside/laguna-xs-2.1:free
# Optional per-Expert overrides. Empty is not allowed; omit a line to use
# OPENROUTER_EXPERT_MODEL. Different IDs create a heterogeneous Expert pool.
OPENROUTER_MEMORY_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_LIFETIME_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_INTEGER_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_TAINT_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_CONTROL_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_CONCURRENCY_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_VALIDATOR_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_PATCH_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_STRONG_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_SWEEP_MODELS=poolside/laguna-xs-2.1:free
OPENROUTER_PROVIDER=
OPENROUTER_STRUCTURED_OUTPUT=false

# OpenRouter request options
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_OUTPUT_TOKENS=2500
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_REASONING_EFFORT=
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=2

# Router and analysis options
CANDIDATE_GATE_ENABLED=false
CANDIDATE_GATE_THRESHOLD=0.40
ANALYSIS_BACKEND=legacy
ROUTER_HIGH_CONFIDENCE=0.72
ROUTER_MIN_MARGIN=0.18
ROUTER_MAX_ENTROPY=1.0
ROUTER_MAX_EXPERTS=2
ROUTER_TARGET_COVERAGE=0.95
USE_RULE_FALLBACK=true
EXPERIMENT_SEED=2026
MAX_CANDIDATES=50
CONTEXT_LINES=25
MAX_CONTEXT_CHARACTERS=30000
# Optional JSONL corpus containing CWE/API contracts, vulnerable patches, and safe examples.
SECURITY_KNOWLEDGE_PATH=
MINIMUM_CONFIDENCE=0.60
USE_LLM_FOR_UNCERTAIN=true
# Run an independent adversarial critic for every statically supported finding.
FALSIFY_ALL_SUPPORTED=true

# Paid notebook cells remain disabled until explicitly enabled.
RUN_PAID_EXPERIMENTS=0
RUN_MODEL_SWEEP=0

# Local web application
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_WORKSPACE_ROOT=.web-data
WEB_ROUTER_ARTIFACT=artifacts/phase2e/router_anchor_rare_v1.pkl
WEB_WORKERS=1
# Web analysis keeps Router-selected logical Experts but submits them in one
# OPENROUTER_EXPERT_MODEL request. Candidates beyond either budget are reported
# as skipped and never trigger a hidden follow-up request.
WEB_CANDIDATE_GATE_ENABLED=true
WEB_DETECTION_MAX_PROMPT_CHARACTERS=120000
WEB_DETECTION_MAX_EXPERT_TASKS=24
WEB_DETECTION_MAX_OUTPUT_TOKENS=8192
# All user-selected validated findings share one coordinated patch request.
WEB_PATCH_MAX_PROMPT_CHARACTERS=120000
WEB_MAX_UPLOAD_FILES=10000
WEB_MAX_UPLOAD_MB=1024
WEB_MAX_SOURCE_FILE_MB=5
WEB_MAX_SOURCE_TOTAL_MB=100
