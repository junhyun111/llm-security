# OpenRouter authentication and role models
OPENROUTER_API_KEY=
OPENROUTER_EXPERT_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_VALIDATOR_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_PATCH_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_STRONG_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_SWEEP_MODELS=poolside/laguna-xs-2.1:free
OPENROUTER_PROVIDER=
OPENROUTER_STRUCTURED_OUTPUT=false

# OpenRouter request options
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_OUTPUT_TOKENS=2500
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_REASONING_EFFORT=
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=2

# Router and analysis options
CANDIDATE_GATE_ENABLED=true
CANDIDATE_GATE_THRESHOLD=0.40
ANALYSIS_BACKEND=legacy
ROUTER_HIGH_CONFIDENCE=0.72
ROUTER_MIN_MARGIN=0.18
ROUTER_MAX_ENTROPY=1.0
ROUTER_MAX_EXPERTS=2
ROUTER_TARGET_COVERAGE=0.95
USE_RULE_FALLBACK=true
EXPERIMENT_SEED=2026
MAX_CANDIDATES=50
CONTEXT_LINES=25
MAX_CONTEXT_CHARACTERS=30000
MINIMUM_CONFIDENCE=0.60
USE_LLM_FOR_UNCERTAIN=true

# Paid notebook cells remain disabled until explicitly enabled.
RUN_PAID_EXPERIMENTS=0
RUN_MODEL_SWEEP=0
