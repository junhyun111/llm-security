# Fill in the API key before running OpenRouter analysis.
OPENROUTER_API_KEY=
OPENROUTER_EXPERT_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_VALIDATOR_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_PATCH_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_STRONG_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_SWEEP_MODELS=deepseek/deepseek-v4-flash-0731

# Optional per-Expert overrides. Blank values inherit OPENROUTER_EXPERT_MODEL.
OPENROUTER_MEMORY_MODEL=
OPENROUTER_LIFETIME_MODEL=
OPENROUTER_INTEGER_MODEL=
OPENROUTER_TAINT_MODEL=
OPENROUTER_CONTROL_MODEL=
OPENROUTER_CONCURRENCY_MODEL=

OPENROUTER_PROVIDER=
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_STRUCTURED_OUTPUT=true

# Leave blank to omit temperature from the OpenRouter request.
OPENROUTER_TEMPERATURE=
OPENROUTER_MAX_OUTPUT_TOKENS=2500
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_REASONING_EFFORT=
WEB_DETECTION_MAX_OUTPUT_TOKENS=8192
WEB_DETECTION_MAX_EXPERT_TASKS=24
WEB_ROUTER_ARTIFACT=Model_Evaluation/artifacts/juliet_utility_router.pkl
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=2

CANDIDATE_GATE_THRESHOLD=0.40
ROUTER_HIGH_CONFIDENCE=0.72
ROUTER_MIN_MARGIN=0.18
ROUTER_MAX_ENTROPY=1.0
ROUTER_MAX_EXPERTS=2
ROUTER_TARGET_COVERAGE=0.95
USE_RULE_FALLBACK=true
EXPERIMENT_SEED=2026
MAX_CANDIDATES=4
CANDIDATE_RANKER_PATH=Model_Evaluation/artifacts/candidate_ranker/candidate_ranker.pkl
CANDIDATE_RANKER_REQUIRED=true
CONTEXT_LINES=25
MAX_CONTEXT_CHARACTERS=30000
MINIMUM_CONFIDENCE=0.60
# Replace these values with validator_minimum_confidence_by_expert from training_report.json.
MINIMUM_CONFIDENCE_MEMORY_BOUNDS=0.60
MINIMUM_CONFIDENCE_INTEGER_SIZE_TYPE=0.60
MINIMUM_CONFIDENCE_TAINT_API_CONTRACT=0.60
MINIMUM_CONFIDENCE_CONTROL_STATE_ERROR=0.60
MINIMUM_CONFIDENCE_CONCURRENCY_TOCTOU=0.60
USE_LLM_FOR_UNCERTAIN=true

RUN_PAID_EXPERIMENTS=1
RUN_MODEL_SWEEP=1
