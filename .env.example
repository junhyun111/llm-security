# Fill in the API key before running OpenRouter analysis.
OPENROUTER_API_KEY=
OPENROUTER_VALIDATOR_MODEL=google/gemini-3.7-flash
OPENROUTER_PATCH_MODEL=google/gemini-3.7-flash
OPENROUTER_STRONG_MODEL=google/gemini-3.7-flash
OPENROUTER_SWEEP_MODELS=google/gemini-3.7-flash
OPENROUTER_PROVIDER=
OPENROUTER_STRUCTURED_OUTPUT=false

OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_OUTPUT_TOKENS=2500
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_REASONING_EFFORT=
WEB_DETECTION_MAX_OUTPUT_TOKENS=8192
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=2

CANDIDATE_GATE_THRESHOLD=0.40
ROUTER_HIGH_CONFIDENCE=0.72
ROUTER_MIN_MARGIN=0.18
ROUTER_MAX_ENTROPY=1.0
ROUTER_MAX_EXPERTS=2
ROUTER_TARGET_COVERAGE=0.95
USE_RULE_FALLBACK=true
EXPERIMENT_SEED=2026
MAX_CANDIDATES=50
CONTEXT_LINES=25
MAX_CONTEXT_CHARACTERS=30000
MINIMUM_CONFIDENCE=0.60
USE_LLM_FOR_UNCERTAIN=true

RUN_PAID_EXPERIMENTS=1
RUN_MODEL_SWEEP=1
