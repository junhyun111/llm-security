# Copy this file to .env. Never commit a real API key.
OPENROUTER_API_KEY=

# This must match the model IDs recorded in artifacts/router.pkl.
OPENROUTER_EXPERT_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_VALIDATOR_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_PATCH_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_STRONG_MODEL=deepseek/deepseek-v4-flash-0731

OPENROUTER_PROVIDER=
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_STRUCTURED_OUTPUT=true
OPENROUTER_TEMPERATURE=
OPENROUTER_MAX_OUTPUT_TOKENS=2500
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_REASONING_EFFORT=

# Set to 1 only after checking the selected model and API budget.
RUN_PAID_EXPERIMENTS=0
RUN_MODEL_SWEEP=0
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=2

ANALYSIS_BACKEND=semantic
MAX_CANDIDATES=4
CANDIDATE_RANKER_REQUIRED=true
CANDIDATE_GATE_ENABLED=true
CANDIDATE_GATE_THRESHOLD=0.40
CONTEXT_LINES=25
MAX_CONTEXT_CHARACTERS=30000

MINIMUM_CONFIDENCE=0.60
MINIMUM_CONFIDENCE_MEMORY_BOUNDS=0.60
MINIMUM_CONFIDENCE_INTEGER_SIZE_TYPE=0.60
MINIMUM_CONFIDENCE_TAINT_API_CONTRACT=0.60
MINIMUM_CONFIDENCE_CONTROL_STATE_ERROR=0.60
MINIMUM_CONFIDENCE_CONCURRENCY_TOCTOU=0.60
USE_LLM_FOR_UNCERTAIN=true

WEB_WORKERS=1
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_CANDIDATE_GATE_ENABLED=true
WEB_DETECTION_MAX_PROMPT_CHARACTERS=120000
WEB_DETECTION_MAX_EXPERT_TASKS=24
WEB_DETECTION_MAX_OUTPUT_TOKENS=8192
WEB_PATCH_MAX_PROMPT_CHARACTERS=120000

